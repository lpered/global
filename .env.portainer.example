# Scheduling
TZ=UTC
DBT_RUN_TIME=07:00
DBT_RUN_ON_START=true
DBT_TARGET=prod
DBT_FULL_REFRESH=false
DBT_DOCS_PORT=33005

# Snowflake (enter these as Portainer stack environment variables)
SNOWFLAKE_ACCOUNT=your-account-identifier
SNOWFLAKE_USER=your-service-user
SNOWFLAKE_PASSWORD=replace-me
SNOWFLAKE_ROLE=your-role
SNOWFLAKE_DATABASE=your-database
SNOWFLAKE_WAREHOUSE=your-warehouse
SNOWFLAKE_PROD_SCHEMA=ANALYTICS_PROD
